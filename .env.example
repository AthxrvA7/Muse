# Copy this file to .env and adjust values for local development.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.

# local | test | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR  (DEBUG is rejected in production)
LOG_LEVEL=INFO

# Serve interactive API docs at /docs
DOCS_ENABLED=true

# Spotify developer app: https://developer.spotify.com/dashboard -> your app -> Settings.
# Leave empty to run without Spotify (search endpoints then answer 503).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Country used for catalogue search (ISO 3166-1 alpha-2, e.g. IN, US, GB)
SPOTIFY_MARKET=IN
