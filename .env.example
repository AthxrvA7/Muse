# Copy this file to .env and adjust values for local development.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.

# local | test | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR  (DEBUG is rejected in production)
LOG_LEVEL=INFO

# Serve interactive API docs at /docs
DOCS_ENABLED=true

# Spotify developer app: https://developer.spotify.com/dashboard -> your app -> Settings.
# Leave empty to run without Spotify (search endpoints then answer 503).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Country used for catalogue search (ISO 3166-1 alpha-2, e.g. IN, US, GB)
SPOTIFY_MARKET=IN

# MongoDB connection string (Atlas: Database -> Connect -> Drivers -> Python).
# Contains the database password: keep it only here. Leave empty to run without a
# database (/ready then reports "degraded"). Required when APP_ENV=production.
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=muse

# Browser origins allowed to call the API (the React frontend), comma-separated.
# Leave empty until the frontend exists. Never use "*".
CORS_ORIGINS=

# Requests per minute from one IP address (defaults shown)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_CURATE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10
